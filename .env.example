[TEMPLATE]
# Copy this file to .env and replace the sample value with your real PostgreSQL URL.
# Keep credentials server-side only.
POSTGRES_DATABASE_URL=postgresql://username:password@localhost:5432/example
# Legacy compatibility only; do not expose to frontend.
DATABASE_URL=${POSTGRES_DATABASE_URL}

# Web Search (DuckDuckGo - free, no API key required)
WEB_SEARCH_ENABLED=true





